# RouteFuel Intelligence local configuration template.
# Generate a private random value for DJANGO_SECRET_KEY in your local .env.
DJANGO_SECRET_KEY=replace-with-a-generated-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Replace with a real maintainer contact. Nominatim asks clients to identify themselves.
NOMINATIM_USER_AGENT=RouteFuelIntelligence/1.0 (contact: your-email@example.com)

# Current public services; no paid provider API key is required by this implementation.
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Dataset and analytics/optimization assumptions.
FUEL_PRICE_CSV=data/fuel-prices-for-be-assessment.csv
FUEL_PRICE_CSV_CLEANED=data/processed/fuel_prices_cleaned.csv
CENSUS_GAZETTEER_URL=https://www2.census.gov/geo/docs/maps-data/data/gazetteer/2026_Gazetteer/2026_Gaz_place_national.zip
FUEL_ROUTE_CORRIDOR_MILES=25
FUEL_ROUTE_MAX_RANGE_MILES=500
FUEL_ROUTE_MPG=10
